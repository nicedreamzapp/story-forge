# Third-party tools are fetched, not vendored. The Rhubarb macOS release is
# ~83 MB zipped and ~276K lines of Sphinx acoustic model + After Effects
# extras; it has its own license and does not belong in this repo's history.
# Get it with rhubarb-pipeline/fetch-rhubarb.sh
rhubarb-pipeline/Rhubarb-Lip-Sync-*-macOS/
rhubarb-pipeline/Rhubarb-Lip-Sync-*.zip

# Per-project render logs — useful locally, noise in git
projects/*/*.log
rhubarb-pipeline/*.log

# Intermediate encodes and editor backups
*.b64
*.upsampler-backup

# Machine-specific run artifacts (they carry local paths) — scrubbed 2026-10-09
projects/**/*.log
projects/**/*.log.*
projects/**/*concat*.txt
projects/**/*_list.txt
projects/**/build_state.json
projects/*/final/scene*.txt
projects/*/final/film.txt
projects/*/final/audio_report.md
projects/*/film_music/*.json
projects/circus_train/build/*.txt
queue/state.json
queue/ledger.csv
queue/processing/
review/verdicts.json

# Acquired footage (frozen rule 28, 2026-10-22): the media stays local (mp4 is ignored above);
# acquired/provenance.json and the per-take .json sidecars ARE tracked.
projects/*/acquired/*.png
projects/*/acquired/*.jpg
projects/*/acquired/*.jpeg
projects/*/acquired/*.webp
projects/*/acquired/**/*.png
projects/*/acquired/**/*.exr
projects/*/acquired/_mock/

# Promo format (2026-10-22): local media a project rebuilds (CAD GLBs, HDRIs, raw takes, strips)
projects/*/assets/
projects/*/vo/raw/
projects/*/final/strips/
projects/*/final/*.png
*.glb
*.exr
projects/*/acquired/.provenance.lock
