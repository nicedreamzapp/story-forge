# Pipeline Check — Story Forge project
# Generated by story-new.  style=pixar-3d  format=film
#
# Render it:
#   sf render projects/pipeline_check/pipeline_check.sf --out projects/pipeline_check/pipeline_check.mp4
#
# Use your OWN art for any scene — replace the `still flux:` block with:
#     still image:
#         path: "{$stills}/your_frame.png"
# (the locked method: lay voice over the untouched animation, never repaint mouths)

$stills = "/Users/dtribe/Desktop/PROJECTS/AI/videopipe/projects/pipeline_check/stills"

film "Pipeline Check" slug=pipeline_check target=m5 style=pixar-3d format=film

# --- cast: one narrator voice + one music bed (add more as needed) ---
voice narrator: piper/en_US-libritts_r-medium speaker=0 length=1.10
# For a cloned character voice instead, use:  voice doug: chatterbox/doug
music score: ace/warm-cinematic-underscore vol=0.30

@transition xfade dur=0.5
@mix duck voice -> music threshold=-22 ratio=4

scene opening:
    still flux:
        prompt: "a wide establishing shot of the main location, calm and inviting, soft natural light"
    motion ltx:
        prompt: "slow ambient drift, gentle light shifts, soft atmosphere, no camera shake"
        duration: 5.0
    narrate narrator:
        line: "Every story starts somewhere quiet. This one starts here."
    music score vol=0.30
