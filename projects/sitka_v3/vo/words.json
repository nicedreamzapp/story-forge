{
 "gap": 0.6,
 "lead": 0.5,
 "engine": "mlx",
 "model": "mlx-community/whisper-large-v3-turbo",
 "lines": [
  {
   "line": 1,
   "wav": "vo/final/part000.wav",
   "start": 0.5,
   "end": 5.085,
   "dur": 4.585,
   "text": "Most exoskeletons fight your body with motors and metal. Sitka works with it.",
   "script_text": "Most exoskeletons fight your body with motors and metal. Sitka works with it."
  },
  {
   "line": 2,
   "wav": "vo/final/part001.wav",
   "start": 5.685,
   "end": 14.521,
   "dur": 8.836,
   "text": "This is Sitka. Named after the tall Sitka spruce trees on the bluffs of Trinidad, California. Strong, light, and it bends without breaking.",
   "script_text": "This is Sitka. Named after the tall Sitka spruce trees on the bluffs of Trinidad, California. Strong, light, and it bends without breaking."
  },
  {
   "line": 3,
   "wav": "vo/final/part002.wav",
   "start": 15.121,
   "end": 22.035,
   "dur": 6.914,
   "text": "Your bones already carry the weight. Sitka adds what your muscles do, with springs, clutches, and cables that work like tendons.",
   "script_text": "Your bones already carry the weight. Sitka adds what your muscles do, with springs, clutches, and cables that work like tendons."
  },
  {
   "line": 4,
   "wav": "vo/final/part003.wav",
   "start": 22.635,
   "end": 30.627,
   "dur": 7.992,
   "text": "Sit down anywhere, and a light pole under each hip takes most of your weight. A carbon spring at each knee catches you, and gives that energy back when you stand.",
   "script_text": "Sit down anywhere, and a light pole under each hip takes most of your weight. A carbon spring at each knee catches you, and gives that energy back when you stand."
  },
  {
   "line": 5,
   "wav": "vo/final/part004.wav",
   "start": 31.227,
   "end": 35.125,
   "dur": 3.898,
   "text": "Lean back, and two simple straps hold you, like a camp chair you wear.",
   "script_text": "Lean back, and two simple straps hold you, like a camp chair you wear."
  },
  {
   "line": 6,
   "wav": "vo/final/part005.wav",
   "start": 35.725,
   "end": 44.224,
   "dur": 8.498,
   "text": "Bend to lift, and a tendon along your back stores energy. A fifteen kilo box feels about twelve kilos lighter, with no motor at all.",
   "script_text": "Bend to lift, and a tendon along your back stores energy. A fifteen kilo box feels about twelve kilos lighter, with no motor at all."
  },
  {
   "line": 7,
   "wav": "vo/final/part006.wav",
   "start": 44.824,
   "end": 51.221,
   "dur": 6.397,
   "text": "Walking and running, elastic bands link your hips, knees, and ankles the way your own hamstrings and calves do.",
   "script_text": "Walking and running, elastic bands link your hips, knees, and ankles, the way your own hamstrings and calves do."
  },
  {
   "line": 8,
   "wav": "vo/final/part007.wav",
   "start": 51.821,
   "end": 61.849,
   "dur": 10.028,
   "text": "Want more? Smart clutches switch the springs on at exactly the right moment. And one small motor on your back helps only where you need it, on stairs, hills, and heavy lifts.",
   "script_text": "Want more? Smart clutches switch the springs on at exactly the right moment. And one small motor on your back helps only where you need it, on stairs, hills, and heavy lifts."
  },
  {
   "line": 9,
   "wav": "vo/final/part008.wav",
   "start": 62.449,
   "end": 74.281,
   "dur": 11.832,
   "text": "It's fully modular. The seat and back kit weighs about fourteen pounds, and runs around two thousand dollars a set when it's built in small batches. Then add hips, ankles, shoulders, and power, all docking into one hub.",
   "script_text": "It's fully modular. The seat and back kit weighs about fourteen pounds, and runs around two thousand dollars a set when it's built in small batches. Then add hips, ankles, shoulders, and power, all docking into one hub."
  },
  {
   "line": 10,
   "wav": "vo/final/part009.wav",
   "start": 74.881,
   "end": 81.21,
   "dur": 6.329,
   "text": "Most of the frame is 3D printed on a desktop printer, and every part is listed with its price, on GitHub.",
   "script_text": "Most of the frame is 3D printed on a desktop printer, and every part is listed with its price, on GitHub."
  },
  {
   "line": 11,
   "wav": "vo/final/part010.wav",
   "start": 81.81,
   "end": 87.353,
   "dur": 5.543,
   "text": "Sitka is completely open. The design, the math, every part. Come build one with us.",
   "script_text": "Sitka is completely open. The design, the math, every part. Come build one with us."
  }
 ],
