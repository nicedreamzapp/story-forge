#!/usr/bin/env bash
# grade in.mp4 out.mp4 --lut NAME [--grain 0-1] [--scope]
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
IN="${1:?usage: grade in.mp4 out.mp4 --lut NAME [--grain 0-1] [--scope]}"; OUT="${2:?}"; shift 2
LUT=""; GRAIN=0; SCOPE=0
while [ $# -gt 0 ]; do case "$1" in
  --lut) LUT="$2"; shift 2;; --grain) GRAIN="$2"; shift 2;; --scope) SCOPE=1; shift;;
  *) echo "unknown arg $1" >&2; exit 2;; esac; done
[ -n "$LUT" ] || { echo "need --lut NAME ($(ls "$ROOT/luts" | sed 's/.cube//' | tr '\n' ' '))" >&2; exit 2; }
F="$ROOT/luts/$LUT.cube"; [ -f "$F" ] || { echo "no such LUT: $LUT" >&2; exit 2; }
VF="lut3d=file='$F':interp=tetrahedral"
if awk "BEGIN{exit !($GRAIN>0)}"; then
  S=$(awk "BEGIN{printf \"%d\", $GRAIN*30}")
  VF="$VF,noise=alls=${S}:allf=t"
fi
if [ "$SCOPE" = 1 ]; then BAR="trunc((ih-iw/2.39)/4)*2"; VF="$VF,drawbox=x=0:y=0:w=iw:h=$BAR:color=black:t=fill,drawbox=x=0:y=ih-$BAR:w=iw:h=$BAR:color=black:t=fill"; fi
ffmpeg -v error -y -i "$IN" -vf "$VF" -c:v libx264 -crf 16 -preset medium -pix_fmt yuv420p -c:a copy "$OUT"
echo "graded -> $OUT"
