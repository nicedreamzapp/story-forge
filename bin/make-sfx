#!/bin/bash
# make-sfx — Story Forge sound effects (MMAudio large 44k v2, text or picture-synced). Usage: see tools/make_sfx.py
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for PY in "$HOME/AI/ComfyUI/venv/bin/python" python3; do
  command -v "$PY" >/dev/null 2>&1 && exec "$PY" "$HERE/tools/make_sfx.py" "$@"
done
echo "make-sfx: no python found" >&2; exit 1
