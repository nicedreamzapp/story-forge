#!/usr/bin/env bash
# forge-session — double-click the app, land in a working session that already knows
# where the film is.
#
# Matt, 2026-07-26: "the whole UI can change when I double click Story Forge… it can
# almost open up into a Claude session. It's usually just a terminal and me describing
# what I want to get done. More hybrid — what would you like to work on today."
#
# So this is the hybrid: the background machine (renderer, UI, director) starts on its
# own, and the foreground is a normal terminal session with the film's real state
# already in the prompt — what's built, what's blocked, what it last did, what's next.
# No re-explaining the project every morning.
#
#   bin/forge-session "hank and doug"
set -u
SF="$HOME/Desktop/PROJECTS/story-forge"
WHAT="${1:-}"

cd "$SF" || exit 1

# 1. background machine up (idempotent; only renders for a project marked ACTIVE_FILM)
bash "$SF/bin/story-forge-start" >> /tmp/story_forge_app.log 2>&1 &

# 2. resolve the film and refresh its status
if [ -n "$WHAT" ]; then
  /usr/bin/python3 "$SF/bin/forge" "$WHAT" > /tmp/forge_resolve.txt 2>&1 || true
fi
PROJ="$(ls -d "$SF"/projects/*/ 2>/dev/null | while read -r d; do [ -f "$d/ACTIVE_FILM" ] && echo "$d"; done | head -1)"

# 3. assemble the briefing the session opens with
BRIEF="/tmp/forge_session_brief.txt"
{
  echo "We're working on Story Forge. RULES.md and CLAUDE.md in this repo are the rules I follow."
  if [ -n "${PROJ:-}" ]; then
    echo ""
    echo "ACTIVE FILM: $(basename "$PROJ")"
    [ -f "$PROJ/STATUS.md" ] && { echo ""; echo "--- current status ---"; sed -n '1,40p' "$PROJ/STATUS.md"; }
    if [ -s "$PROJ/QUESTIONS.md" ]; then echo ""; echo "--- waiting on a human ---"; sed -n '1,25p' "$PROJ/QUESTIONS.md"; fi
    echo ""
    echo "--- what the director did last ---"
    tail -12 "$PROJ/director.log" 2>/dev/null
  else
    echo ""
    echo "No film is armed. Films available:"
    /usr/bin/python3 "$SF/bin/forge" list 2>/dev/null
  fi
  echo ""
  echo "Give me a one-screen summary of where the film stands and the single most useful"
  echo "next action, then ask what I want to work on. Keep it short — table first."
} > "$BRIEF"

# 4. hand over to a real terminal session, with the briefing as the opening prompt
osascript <<OSA
tell application "Terminal"
	activate
	do script "cd '$SF' && clear && echo '── Story Forge ──' && claude \"\$(cat $BRIEF)\""
end tell
OSA
