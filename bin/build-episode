# ───────────────────────── stages ─────────────────────────

def stage_preflight(proj, st):
    ok = True
    services = sf_status()
    if services:
        log(f"  Song Forge: ace={services.get('ace_up')} llm={services.get('llm_up')} "
            f"jobs_running={services.get('jobs_running')}")
    else:
        log("  Song Forge: UNREACHABLE — score stage will fall back to the saved bed")

    missing, present = [], 0
    for e in EDL:
        if e["kind"] == "card":
            continue
        p = proj / e["src"]
        if not p.is_file() or p.stat().st_size < 1000:
            missing.append(e["src"])
        else:
            present += 1
        if e.get("vo"):
            v = proj / e["vo"][0]
            if not v.is_file():
                missing.append(e["vo"][0])
    log(f"  assets: {present} clips present, {len(missing)} missing")
    for m in missing:
        log(f"    MISSING → {m} (its segment will be skipped)")
    st["missing"] = missing
    if present == 0:
        log("  ABORT: no usable footage at all")
        ok = False
    if not mem_gate("build-episode preflight"):
        log("  ABORT: memory gate refused")
        ok = False

    # POINTER GATE (added 2026-07-27, rule 17). Every other gate judges an ASSET.
    # Nothing judged the POINTER, so s4_arrival sat in the EDL aimed at
    # clips/s3_final.mp4 — a shot matching all three of its own must_not entries —
    # and beat_gate dutifully judged the wrong file against the wrong beat and passed.
    # This is a string compare. It runs before the VL model is ever loaded.
    beats_p = proj / "beats.json"
    if beats_p.is_file():
        bd = json.loads(beats_p.read_text())
        by_id = {s["id"]: s for s in bd.get("shots", [])}
        problems = []
        for e in EDL:
            if e["kind"] != "scene":
                continue
            s = by_id.get(e["id"])
            if not s:
                problems.append(f"EDL scene {e['id']!r} has NO entry in beats.json — "
                                "it ships completely ungated")
                continue
            declared = s.get("clip") or s.get("image")
            if declared and declared != e["src"]:
                problems.append(f"{e['id']}: EDL points at {e['src']} but beats.json "
                                f"declares {declared} — one of them is the wrong shot")
        # a spine beat whose shot id has no shots[] entry is invisible to beat_gate
        for sp in bd.get("spine", []):
            ids = sp.get("shots", [])
            if ids and not any(i in by_id for i in ids):
                problems.append(f"spine beat {sp['beat'][:50]!r} names {ids} — none has a "
                                "shots[] entry, so nothing ever judges it")
        for p_ in problems:
            log(f"    POINTER → {p_}")
        if problems:
            log("  ABORT: the edit and the script disagree about which file is which shot")
            ok = False
        else:
            log(f"  pointer gate: {sum(1 for e in EDL if e['kind']=='scene')} scenes agree "
                "with beats.json")

    # STORY GATE (added 2026-07-25 after the "stick in the door" cut). film_qc
    # judges mouths, faces, limbs and audio timing — all of which PASS on a shot
    # that depicts the wrong action entirely. beat_gate asks the only question
    # that catches that: does this picture show its beat. It is a hard stop:
    # a cut is never assembled out of shots that don't tell the story.
    beats = proj / "beats.json"
    if not beats.is_file():
        log("  story gate: no beats.json — shots are UNCHECKED against the script")
        st["beat_gate"] = "UNCHECKED — no beats.json"
    elif not MLX_PY.is_file() or not BEAT_GATE.is_file():
        log("  story gate: UNAVAILABLE (beat_gate or its interpreter missing) — UNCHECKED")
        st["beat_gate"] = "UNAVAILABLE"
    else:
        # Judge EXACTLY what the film ships, nothing else. beats.json accumulates
        # entries for wip candidates and build intermediates that lost or were never
        # wired in; judging those made a stale corpse able to ABORT a good cut
        # (2026-07-27). Scope the gate to the EDL's scenes and write the filtered
        # copy next to the report so the ruling is reproducible.
        bd = json.loads(beats.read_text())
        by_id = {s["id"]: s for s in bd.get("shots", [])}
        edl_ids = [e["id"] for e in EDL if e["kind"] == "scene"]
        shipped = [by_id[i] for i in edl_ids if i in by_id]
        skipped = [s["id"] for s in bd.get("shots", []) if s["id"] not in edl_ids]
        beats = proj / "beats_edl.json"
        beats.write_text(json.dumps({**bd, "shots": shipped}, indent=1))
        if skipped:
            log(f"  story gate scope: {len(shipped)} shots in the cut; "
                f"not in the cut, not judged: {', '.join(skipped)}")
        log("  running beat_gate (does every shot depict its beat?)…")
        r = run([str(MLX_PY), str(BEAT_GATE), str(beats),
                 "--report", str(proj / "BEAT_GATE_report.md")])
        tail = (r.stdout or "").strip().splitlines()
        for line in tail[-40:]:
            if line.startswith(("[PASS]", "[FAIL]", "[ERR")):
                log("    " + line)
        st["beat_gate"] = "\n".join(tail[-40:])
        st["beat_gate_exit"] = r.returncode
        # Two questions, two proportionate consequences (2026-07-27). "Does this shot
        # tell the story?" is rule 14 and stays a HARD STOP. "Is this the same paint
        # as the other car?" is polish — real, worth reporting loudly, but it must not
        # block a cut whose spine is intact. Conflating them meant a shot passing its
        # beat 3/3 could abort the film over a shade of red, which pushes toward
        # disabling the gate entirely — the worst outcome of the three.
        beat_fails = [l for l in tail if l.startswith("[FAIL]") and "BEAT PASS" not in l]
        set_only = [l for l in tail if l.startswith("[FAIL]") and "BEAT PASS" in l]
        for l in set_only:
            log(f"  SET DRIFT (not blocking, ships as a known defect): {l[:150]}")
        if beat_fails:
            log("  ABORT: shots that do not depict their beat are in the EDL — "
                "reshoot them or drop them from the EDL before assembling")
            ok = False
        elif r.returncode == 1:
            log(f"  {len(set_only)} shot(s) fail SET CONTINUITY only — the story is intact, "
                "assembling and reporting them as known defects")
        elif r.returncode != 0:
            log("  story gate COULD NOT RUN — treat every shot as UNCHECKED, never as a pass")
    return ok


def stage_song(proj, st, want_song=True):
    """Pause the build and commission an original score. Customer jobs come first."""
    out = proj / "score.wav"
    if not want_song:
        log("  --no-song: using the existing music bed")
        st["score"] = "music_bed.wav"
        return True

    s = sf_status()
    if not s or not (s.get("ace_up") and s.get("llm_up")):
        log("  Song Forge not healthy — falling back to music_bed.wav")
        st["score"] = "music_bed.wav"
        return True

    waited = 0
    while (sf_status() or {}).get("jobs_running", 0) > 0 and waited < 1800:
        log("  a customer song is rendering — waiting (customers outrank us)")
        time.sleep(60)
        waited += 60

    body = json.dumps({
        "title": "The Wild Rescue",
        "style": ("instrumental, no vocal, warm acoustic folk, playful, organic, dusty, "
                  "downtempo adventure, banjo and ukulele, light whistling melody, "
                  "gentle percussion, storybook feel, 88 bpm, clean mix"),
        "bpm": 88, "duration": 150, "guidance_scale": 6,
        "inference_steps": 32, "lyrics": "[instrumental]",
        # Song Forge renders this, but it is FILM MUSIC and must never land in
        # Matt's song library, Music.app, or the public songs page. Without this
        # a 150s cue clears LIBRARY_MIN_DURATION and files itself next to his
        # real songs (Matt, 2026-07-29: "I don't wanna hear any Hank and Doug
        # songs ... when I'm listening to my songs"). The film keeps its own
        # copy at projects/<film>/score.wav regardless.
        "video_only": True,
    }).encode()
    try:
        req = urllib.request.Request(f"{SONGFORGE}/api/song", data=body,
                                     headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=60) as r:
            j = json.load(r)
        # Song Forge answers {"id": ...}; older builds said task_id. Accept both,
        # and REFUSE to poll a null id (that silently wasted a whole run 2026-07-25).
        jid = j.get("id") or j.get("task_id") or (j.get("ids") or [None])[0]
        if not jid:
            raise RuntimeError(f"no job id in response: {j}")
    except Exception as e:
        log(f"  song request failed ({e}) — falling back to music_bed.wav")
        st["score"] = "music_bed.wav"
        return True

    log(f"  commissioned score {jid} — polling")
    t0 = time.time()
    while time.time() - t0 < 2400:
        try:
            with urllib.request.urlopen(f"{SONGFORGE}/api/song/{jid}", timeout=20) as r:
                j = json.load(r)
        except Exception:
            time.sleep(15)
            continue
        if j.get("status") == "done":
            url = f"{SONGFORGE}{j['audio']}"
            urllib.request.urlretrieve(url, out)
            log(f"  score ready: {duration(out):.0f}s → score.wav")
            st["score"] = "score.wav"
            st["score_job"] = jid
            return True
        if j.get("status") == "error":
            break
        time.sleep(20)
    log("  score did not finish — falling back to music_bed.wav")
    st["score"] = "music_bed.wav"
    return True


def _card(path, title, subtitle, seconds):
    """Typeset card. drawtext is NOT installed in this ffmpeg — build with PIL."""
    from PIL import Image, ImageDraw, ImageFont
    im = Image.new("RGB", (W, H), (18, 14, 12))
    d = ImageDraw.Draw(im)
    for y in range(H):  # warm vertical wash so it doesn't read as a flat slate
        t = y / H
        d.line([(0, y), (W, y)], fill=(int(24 + 26 * t), int(17 + 15 * t), int(14 + 9 * t)))

    def font(sz):
        for f in ("/System/Library/Fonts/Supplemental/Georgia Bold.ttf",
                  "/System/Library/Fonts/Supplemental/Georgia.ttf",
                  "/System/Library/Fonts/Helvetica.ttc"):
            if Path(f).is_file():
                try:
                    return ImageFont.truetype(f, sz)
                except Exception:
                    pass
        return ImageFont.load_default()

    def centre(text, y, f, fill):
        bb = d.textbbox((0, 0), text, font=f)
        d.text(((W - (bb[2] - bb[0])) / 2, y), text, font=f, fill=fill)

    centre(title, H * 0.34, font(52), (247, 226, 186))
    if subtitle:
        centre(subtitle, H * 0.52, font(24), (196, 160, 122))
    png = path.with_suffix(".png")
    im.save(png)
    # color_range MUST be declared. A card encoded with range "unknown" concatenated
    # against scenes tagged "tv" produces a stream QuickTime refuses to decode past
    # the first segment — it holds the title frame for the whole film while ffmpeg
    # reads it fine. That shipped a "59 seconds of intro screen" cut on 2026-07-25.
    ff(["-loop", "1", "-t", str(seconds), "-i", str(png),
        "-f", "lavfi", "-t", str(seconds), "-i", f"anullsrc=r={AR}:cl=stereo",
        "-vf", f"scale={W}:{H},fps={FPS},setsar=1,format=yuv420p",
        "-c:v", "libx264", "-crf", "18", "-pix_fmt", "yuv420p",
        "-color_range", "tv", "-colorspace", "bt709",
        "-color_primaries", "bt709", "-color_trc", "bt709",
        "-c:a", "aac", "-b:a", "160k", "-shortest", str(path)], "card")
    png.unlink(missing_ok=True)


def stage_cards(proj, st):
    work = proj / "build"
    work.mkdir(exist_ok=True)
    _card(work / "card_title.mp4", "Hank & Doug's Wild Rescue", "The Circus Train", 4.0)
    _card(work / "card_credits.mp4", "The Wild Rescue rolls.",
          "Made locally on Story Forge", 5.0)
    log("  title + credit cards built")
    return True


def stage_segments(proj, st):
    """Normalise everything to one spec and place off-screen VO."""
    work = proj / "build"
    work.mkdir(exist_ok=True)

    # WIPE stale segments first. Segment files are named seg<index>_<id>.mp4, so
    # dropping ONE shot from the EDL renumbers everything after it — the new files
    # land beside the old ones instead of replacing them. Assembly then globbed the
    # directory and swept up both sets, which on 2026-07-28 shipped a cut containing
    # the s5_door shot that had been DROPPED for failing its beat 0/3, four dialogue
    # lines played twice, and the credits card in the MIDDLE of the film.
    # The log said "23 segments normalised" and then "assembled from 29 segments".
    stale = sorted(work.glob("seg*.mp4"))
    for p in stale:
        p.unlink()
    if stale:
        log(f"  cleared {len(stale)} segment(s) from a previous build")

    built, skipped = [], []
    timeline, scenes, clock = [], [], 0.0

    for idx, e in enumerate(EDL):
        out = work / f"seg{idx:02d}_{e['id']}.mp4"
        if e["kind"] == "card":
            src = work / ("card_title.mp4" if e["id"] == "title" else "card_credits.mp4")
        else:
            src = proj / e["src"]
        if not src.is_file():
            skipped.append(e["id"])
            continue

        dur = duration(src)
        if e.get("trim"):
            dur = min(dur, e["trim"])

        vf = (f"scale={W}:{H}:force_original_aspect_ratio=decrease,"
              f"pad={W}:{H}:(ow-iw)/2:(oh-ih)/2,fps={FPS},setsar=1,format=yuv420p")
        args = ["-t", f"{dur:.3f}", "-i", str(src)]
        vo = e.get("vo")
        vo_path = proj / vo[0] if vo else None
        if vo and not vo_path.is_file():
            vo, vo_path = None, None

        if vo:
            delay_ms = int(vo[1] * 1000)
            args += ["-i", str(vo_path)]
            if has_audio(src):
                fc = (f"[0:v]{vf}[v];"
                      f"[0:a]aresample={AR},aformat=channel_layouts=stereo[a0];"
                      f"[1:a]aresample={AR},aformat=channel_layouts=stereo,"
                      f"adelay={delay_ms}|{delay_ms},volume=1.25[a1];"
                      f"[a0][a1]amix=inputs=2:duration=first:dropout_transition=0,"
                      f"apad,atrim=duration={dur:.3f}[a]")
            else:
                fc = (f"[0:v]{vf}[v];"
                      f"[1:a]aresample={AR},aformat=channel_layouts=stereo,"
                      f"adelay={delay_ms}|{delay_ms},volume=1.25,"
                      f"apad,atrim=duration={dur:.3f}[a]")
        else:
            if has_audio(src):
                fc = (f"[0:v]{vf}[v];[0:a]aresample={AR},"
                      f"aformat=channel_layouts=stereo,apad,atrim=duration={dur:.3f}[a]")
            else:
                args += ["-f", "lavfi", "-t", f"{dur:.3f}",
                         "-i", f"anullsrc=r={AR}:cl=stereo"]
                fc = f"[0:v]{vf}[v];[1:a]aresample={AR}[a]"

        ff([*args, "-filter_complex", fc, "-map", "[v]", "-map", "[a]",
            "-c:v", "libx264", "-crf", "18", "-preset", "medium",
            "-c:a", "aac", "-b:a", "160k", str(out)], e["id"])
        built.append(out.name)
        # Track the running timeline so QC can be told exactly WHEN each line lands.
        seg_dur = duration(out)
        if e.get("say"):
            say = e["say"]
            offset = say[2] if len(say) > 2 else 0.15
            # A line carried by VO has no mouth on screen — mark it so QC checks the
            # audio and skips lip sync instead of failing a character who is, by
            # design, behind a door or out of frame.
            # dur lets QC measure mouth coverage across the WHOLE line rather than
            # sampling an instant — the difference between catching a character who
            # talks with a shut muzzle and rubber-stamping it.
            line_span = duration(proj / e["vo"][0]) if e.get("vo") else seg_dur
            timeline.append({"t": round(clock + offset, 2),
                             "speaker": say[0], "text": say[1],
                             "dur": round(max(0.6, line_span - offset), 2),
                             "offscreen": bool(e.get("vo"))})
        if e["kind"] == "scene":
            scenes.append({"name": e["id"], "start": round(clock, 2),
                           "end": round(clock + seg_dur, 2)})
        clock += seg_dur
        tag = " +VO" if vo else ""
        tag += f" (trimmed to {dur:.1f}s)" if e.get("trim") else ""
        log(f"  {e['id']}: {dur:.2f}s{tag}")

    st["segments"] = built
    st["skipped"] = skipped
    st["lines"] = timeline
    st["scenes"] = scenes
    if skipped:
        log(f"  SKIPPED (asset missing): {', '.join(skipped)}")
    log(f"  {len(built)} segments normalised to {W}x{H}@{FPS}")
    st["segments"] = [str(b) for b in built]      # the authoritative cut list
    return bool(built)


def stage_assemble(proj, st):
    work = proj / "build"
    # Assemble EXACTLY what stage_segments built, in EDL order. This used to be
    # sorted(work.glob("seg*.mp4")) — the directory, not the edit. Anything left on
    # disk from an earlier build got concatenated as if it were part of the film
    # (2026-07-28: a dropped shot, four doubled lines, credits in the middle).
    # The edit decides what is in the film; the filesystem does not get a vote.
    segs = [work / s for s in st.get("segments", [])]
    if not segs:
        log("  no segment list from the segments stage — refusing to guess from disk")
        return False
    missing = [s for s in segs if not s.is_file()]
    if missing:
        log(f"  ABORT: {len(missing)} segment(s) named by the edit are missing")
        return False
    extra = sorted(set(work.glob("seg*.mp4")) - set(segs))
    if extra:
        log(f"  {len(extra)} stray segment file(s) on disk are NOT in the edit "
            f"and are being ignored: {', '.join(p.name for p in extra[:6])}")
    lst = work / "concat.txt"
    lst.write_text("".join(f"file '{s}'\n" for s in segs))

    # RE-ENCODE, never -c copy. Stream-copy concat only works if every segment
    # matches on profile/level/pix_fmt/color-range/timebase; one stray parameter and
    # strict players (QuickTime) freeze on the first frame for the whole runtime.
    # One clean encode of a 60s 832x480 cut costs seconds and always plays.
    silent = work / "cut_nomusic.mp4"
    ff(["-f", "concat", "-safe", "0", "-i", str(lst),
        "-c:v", "libx264", "-crf", "18", "-preset", "medium",
        "-pix_fmt", "yuv420p", "-color_range", "tv", "-colorspace", "bt709",
        "-color_primaries", "bt709", "-color_trc", "bt709",
        "-r", str(FPS), "-c:a", "aac", "-b:a", "160k", "-movflags", "+faststart",
        str(silent)], "concat")
    total = duration(silent)
    log(f"  cut assembled: {total:.1f}s from {len(segs)} segments")

    score = proj / st.get("score", "music_bed.wav")
    out = proj / "EPISODE_v1.mp4"
    if score.is_file():
        # Music sits under everything and ducks itself out of the way whenever
        # a voice is present — sidechain keyed off the dialogue bus.
        fc = (f"[1:a]aloop=loop=-1:size=2e9,atrim=duration={total:.3f},"
              f"volume=0.42,aresample={AR},aformat=channel_layouts=stereo[m];"
              f"[0:a]aresample={AR},aformat=channel_layouts=stereo,asplit=2[d][key];"
              f"[m][key]sidechaincompress=threshold=0.035:ratio=9:attack=12:release=420[mq];"
              f"[d][mq]amix=inputs=2:duration=first:normalize=0,"
              f"alimiter=limit=0.95,afade=t=out:st={max(0, total-2.2):.2f}:d=2.2[a]")
        ff(["-i", str(silent), "-i", str(score), "-filter_complex", fc,
            "-map", "0:v", "-map", "[a]", "-c:v", "copy",
            "-c:a", "aac", "-b:a", "192k", "-movflags", "+faststart",
            str(out)], "score-mux")
        log(f"  score laid under and ducked: {score.name}")
    else:
        shutil.copy(silent, out)
        log("  no score available — cut is dialogue-only")

    st["film"] = str(out)
    st["runtime"] = duration(out)
    log(f"  FILM: {out}  ({st['runtime']:.1f}s)")
    return True


def stage_qc(proj, st):
    """MANDATORY. Never report 'done' without this; exit 2 is NOT a pass."""
    film = Path(st.get("film", ""))
    if not film.is_file():
        return False
    # film_qc wants characters as a DICT (name -> visual description) and every
    # line stamped at its position in the FINAL timeline. Passing a list silently
    # crashed the whole QC stage on 2026-07-25 — the film shipped UNCHECKED.
    manifest = proj / "build" / "qc_manifest.json"
    manifest.write_text(json.dumps({
        "characters": {
            "hank": "large round brown bear standing upright, cream muzzle",
            "doug": "lanky tan bloodhound dog with long dark floppy ears, no collar",
            "ellie": "young circus elephant, warm grey, red-plumed crown",
            "bird": "off-screen only, never visible",
        },
        "scenes": st.get("scenes", []),
        "lines": st.get("lines", []),
    }, indent=2))
    log(f"  manifest: {len(st.get('lines', []))} lines, {len(st.get('scenes', []))} scenes")
    if not MLX_PY.is_file() or not FILM_QC.is_file():
        st["qc"] = "UNAVAILABLE — film_qc or its interpreter is missing; film is UNCHECKED"
        log(f"  {st['qc']}")
        return True
    if not mem_gate("film_qc"):
        st["qc"] = "SKIPPED — memory gate refused; film is UNCHECKED"
        log(f"  {st['qc']}")
        return True
    log("  running film_qc (vision + audio judge)…")
    r = run([str(MLX_PY), str(FILM_QC), str(film), str(manifest)], timeout=3600)
    tail = (r.stdout or r.stderr).strip().splitlines()[-14:]
    st["qc"] = "\n".join(tail)
    st["qc_exit"] = r.returncode
    for line in tail:
        log(f"    {line}")
    # ONLY exit 0 is a pass. This used to test `== 2` alone, so a film_qc that was
    # SIGKILLed/SIGTERMed (negative returncode) fell straight through in silence and
    # the run went on to print COMPLETE — which is exactly what happened on
    # 2026-07-27: reservation denied, film_qc killed at -15, no report written since
    # Jul 25, and the build announced a finished film. Same class as this morning's
    # "stop calling a blocked stop FILM COMPLETE", in a different stage.
    if r.returncode == 0:
        st["qc_verdict"] = "PASS"
    elif r.returncode == 1:
        st["qc_verdict"] = "DEFECTS — read the _qc.md report"
        log("  film_qc found DEFECTS — read the report before showing anyone")
    elif r.returncode == 2:
        st["qc_verdict"] = "UNCHECKED — film_qc could not run"
        log("  film_qc COULD NOT RUN — treat as UNCHECKED, never as a pass")
    else:
        st["qc_verdict"] = f"UNCHECKED — film_qc was KILLED (exit {r.returncode})"
        log(f"  film_qc was KILLED (exit {r.returncode}) — the film is UNCHECKED, "
            "not verified. Do NOT report it as done.")
    return True


def main():
    ap = argparse.ArgumentParser(description="Assemble a finished cartoon end to end.")
    ap.add_argument("project", help="project dir, e.g. projects/circus_train")
    ap.add_argument("--from", dest="start", choices=STAGES, default=None,
                    help="rerun from this stage onward")
    ap.add_argument("--no-song", action="store_true",
                    help="skip commissioning a score; use the saved music bed")
    args = ap.parse_args()

    proj = Path(args.project).expanduser().resolve()
    if not proj.is_dir():
        sys.exit(f"no such project: {proj}")
    state_p = proj / "build_state.json"
    st = json.loads(state_p.read_text()) if state_p.is_file() else {}
    done = set(st.get("done", []))
    if args.start:
        done -= set(STAGES[STAGES.index(args.start):])

    fns = {"preflight": stage_preflight, "song": lambda p, s: stage_song(p, s, not args.no_song),
           "cards": stage_cards, "segments": stage_segments,
           "assemble": stage_assemble, "qc": stage_qc}

    t0 = time.time()
    for name in STAGES:
        if name in done:
            log(f"{name.upper()} — already done, skipping")
            continue
        log(f"{name.upper()} —")
        if not fns[name](proj, st):
            log(f"STOPPED at {name}")
            st["done"] = sorted(done)
            state_p.write_text(json.dumps(st, indent=2))
            sys.exit(1)
        done.add(name)
        st["done"] = sorted(done)
        state_p.write_text(json.dumps(st, indent=2))

    # "COMPLETE" is a claim about VERIFICATION, not about ffmpeg finishing. A cut whose
    # QC never ran is ASSEMBLED, not complete, and saying otherwise is the single most
    # expensive lie this pipeline can tell (2026-07-22 "Every Day", 2026-07-25 stick-in-
    # the-door, and again tonight when film_qc was killed and the run said COMPLETE).
    verdict = st.get("qc_verdict", "UNCHECKED — QC stage never recorded a verdict")
    mins = (time.time() - t0) / 60
    if verdict == "PASS":
        log(f"COMPLETE in {mins:.1f} min → {st.get('film')}")
    else:
        log(f"ASSEMBLED (NOT VERIFIED) in {mins:.1f} min → {st.get('film')}")
        log(f"  QC: {verdict}")
        log("  This film has NOT passed QC. Do not publish or call it done.")
    if st.get("skipped"):
        log(f"NOT INCLUDED (assets missing): {', '.join(st['skipped'])}")

    # THE FILM GOES TO MATT'S TAB BY ITSELF (2026-07-31, 4pm: a finished cut sat
    # on disk for 50 minutes because the agent that launched the build never came
    # back to hand it over — "the flow is not happening like I need it"). The
    # pipeline delivers its own output: queue the cut for his click and open the
    # review page. Never depend on whoever launched the build to remember.
    film = st.get("film")
    if film and Path(film).is_file():
        q = ("UNMUTE. " + ("QC PASSED — " if verdict == "PASS" else
             "QC has known defects (see report) — ") + "good to call it done?")
        try:
            subprocess.run([str(SF / "bin" / "review-add"), str(film),
                            f"{proj.name} full cut, {mins:.0f}min build. {q}"],
                           capture_output=True, text=True, timeout=15)
            # Only open the tab if the review server is actually answering
            # (2026-08-30: it was down and every build popped a BLANK page on
            # Matt's screen). A dead tab is worse than no tab.
            import urllib.request
            try:
                urllib.request.urlopen("http://127.0.0.1:17600/review", timeout=3)
                subprocess.run(["open", "-a", "Brave Browser",
                                "http://127.0.0.1:17600/review"],
                               capture_output=True, timeout=10)
                log("cut queued to Matt's review tab (auto)")
            except Exception:
                log("cut queued for review, but the review server (:17600) is down — "
                    "tab NOT opened; start it with bin/story-forge-start")
        except Exception as e:                                    # noqa: BLE001
            log(f"could not auto-queue the cut for review: {e}")


if __name__ == "__main__":
    main()
