#!/usr/bin/env python3
"""
build-episode — assemble a finished cartoon from approved assets, end to end.

Stages, cheapest first, each one gated so a stage never starts work the machine
can't finish:

  0  PREFLIGHT   services up, memory healthy, every asset present and non-zero
  1  SONG        pause and commission an original score from Song Forge
  2  CARDS       title + credit cards (Flux still, or a clean typeset fallback)
  3  SEGMENTS    normalise every scene/insert to one spec; place off-screen VO
  4  ASSEMBLE    concat in story order, score underneath, ducked under dialogue
  5  QC          film_qc over the finished cut; report verbatim, never paper over

Design rules it follows (all learned the hard way, see CLAUDE.md):
  - Song Forge customer jobs OUTRANK renders. Stage 1 waits them out.
  - Every heavy step passes bin/mem-gate first; it refuses rather than swap-storm.
  - Rejected assets are never silently shipped. A scene Matt rejected is either
    trimmed to its good portion (declared in EDL) or dropped, and the run reports it.
  - Missing assets do not abort the film. The stage logs the gap and builds what
    it can — "only do what it knows it can".

State lives in build_state.json, so a rerun skips completed stages. --from resets.

    bin/build-episode projects/circus_train
    bin/build-episode projects/circus_train --from song    # redo score onward
"""
import argparse
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

# ffmpeg by ABSOLUTE path. Under launchd/keepalive the PATH has no /opt/homebrew/bin,
# so a bare "ffmpeg" raises FileNotFoundError — which is how forge-director died at
# 19:25 on 2026-07-27 and keepalive then logged "film complete — done" (2026-07-27:
# the third time in one day a crash was reported as a finished film).
import shutil as _shutil
FFMPEG = _shutil.which("ffmpeg") or "/opt/homebrew/bin/ffmpeg"


SF = Path(__file__).resolve().parent.parent
MEM_GATE = SF / "bin" / "mem-gate"
FILM_QC = SF / "pipeline-tools" / "film_qc.py"
BEAT_GATE = SF / "pipeline-tools" / "beat_gate.py"
MLX_PY = Path.home() / ".local/mlx-server/bin/python"
SONGFORGE = os.environ.get("SONGFORGE_URL", "http://127.0.0.1:8767")

W, H, FPS, AR = 832, 480, 24, 44100
STAGES = ["preflight", "song", "cards", "segments", "assemble", "qc"]


def log(msg):
    print(f"[build-episode] {msg}", flush=True)


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def ff(args, label=""):
    r = run([FFMPEG, "-y", "-loglevel", "error", *args])
    if r.returncode:
        raise RuntimeError(f"ffmpeg failed {label}: {r.stderr[-600:]}")


def probe(path, entries, stream=False):
    sel = ["-select_streams", "v:0"] if stream else []
    r = run(["ffprobe", "-v", "error", *sel, "-show_entries", entries,
             "-of", "default=nw=1:nk=1", str(path)])
    return r.stdout.strip()


def duration(path):
    try:
        return float(probe(path, "format=duration"))
    except ValueError:
        return 0.0


def has_audio(path):
    r = run(["ffprobe", "-v", "error", "-select_streams", "a",
             "-show_entries", "stream=codec_name", "-of", "csv=p=0", str(path)])
    return bool(r.stdout.strip())


def mem_gate(label):
    """Refuse to start heavy work the machine can't afford (frozen rule 11)."""
    if not MEM_GATE.is_file():
        return True
    r = run([str(MEM_GATE), label])
    for line in (r.stdout + r.stderr).splitlines():
        if line.strip():
            log(f"  mem-gate: {line.strip()}")
    return r.returncode == 0


def sf_status():
    try:
        with urllib.request.urlopen(f"{SONGFORGE}/api/status", timeout=8) as r:
            return json.load(r)
    except Exception:
        return None


