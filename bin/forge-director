#!/usr/bin/env python3
"""forge-director — the thing that never stops until the film is done.

The flaw this fixes (Matt, 2026-07-26): "I'm confused that it stopped… it just
stopped making the movie on its own." Every stage until now was a script that ran
once, finished, and sat there waiting for a human to notice and start the next one.
A queue that ends is not a pipeline; it's an errand.

The director owns the FILM, not a step. It loops:

    1. read the story spine — the beats this film cannot exist without
    2. work out which beats still have no footage that passes the gates
    3. pick the next gap and drive it: still → gate → lock → animate → gate
    4. on failure, ESCALATE rather than repeat: shorter clip, then a fresh
       approach, then mark BLOCKED-with-reason and MOVE ON to the next gap
    5. write STATUS.md every cycle so there is always something to read
    6. when every beat has footage, assemble the cut, QC it, and only then stop

It stops for exactly three reasons, and says which: the film is finished, every
remaining gap is BLOCKED and needs a human decision, or the machine refused the
work (memory gate). Idling silently is not one of them.

    bin/forge-director projects/circus_train              # run until done
    bin/forge-director projects/circus_train --max-hours 6
    bin/forge-director projects/circus_train --dry-run    # show the plan only

Keep it alive across crashes:
    bin/forge-keepalive projects/circus_train
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
import time
from pathlib import Path

SF = Path(__file__).resolve().parent.parent
FORGE_SHOT = SF / "bin" / "forge-shot"
FORGE_REVIEW = SF / "bin" / "forge-review"
BUILD_EPISODE = SF / "bin" / "build-episode"
MLX_PY = Path.home() / ".local/mlx-server/bin/python"
MAX_ATTEMPTS = 3


def log(m: str) -> None:
    print(f"[director {time.strftime('%H:%M:%S')}] {m}", flush=True)


def read_json(p, default):
    try:
        return json.loads(Path(p).read_text())
    except Exception:
        return default


def write_json(p, data):
    Path(p).write_text(json.dumps(data, indent=1) + "\n")


def has_footage(proj: Path, shot_ids: list) -> str | None:
    """A beat is covered only by a clip that exists and is non-trivial."""
    for sid in shot_ids:
        for cand in sorted((proj / "clips").glob(f"{sid}*.mp4")):
            if cand.is_file() and cand.stat().st_size > 50_000 and "_failed" not in str(cand):
                return cand.name
    return None


def gaps(proj: Path, state: dict) -> list:
    spine = read_json(proj / "beats.json", {}).get("spine", [])
    out = []
    for need in spine:
        if has_footage(proj, need.get("shots", [])):
            continue
        shot_id = next((s for s in need.get("shots", []) if s in state.get("catalog", {})),
                       None) or (need.get("shots") or [None])[0]
        if state.get("blocked", {}).get(shot_id):
            continue
        out.append((need["beat"], shot_id))
    return out


def escalate(spec: dict, attempt: int) -> dict:
    """Never re-run the identical thing twice. Each attempt changes something real."""
    spec = dict(spec)
    if attempt == 1:
        # animations drift over 5s far more than over 3s
        spec["duration"] = 3
        spec["seeds"] = [s + 3000 for s in spec.get("seeds", [11, 47, 82, 119])]
        spec["_escalation"] = "shorter clip (3s), fresh seeds"
    elif attempt >= 2:
        # stop animating at all: a held frame that passes beats the best clip that doesn't
        spec.pop("animate", None)
        spec["_escalation"] = "still only — no animation attempt"
    return spec


def run_shot(proj: Path, spec: dict) -> dict:
    tmp = proj / "_director_shot.json"
    write_json(tmp, {"defaults": {"res": "832x480",
                                  "duration": spec.get("duration", 5),
                                  "seeds": spec.get("seeds", [11, 47, 82, 119]),
                                  "votes": 3},
                     "shots": [spec]})
    r = subprocess.run([str(MLX_PY), str(FORGE_SHOT), str(tmp)],
                       capture_output=True, text=True, timeout=7200)
    for line in (r.stdout or "").splitlines():
        if line.startswith("[") and ("beat " in line or "LOCKED" in line or "clip:" in line
                                     or "identity" in line or "UNBUILT" in line):
            log("  " + line.split("] ", 1)[-1][:150])
    res = read_json(proj / "forge_shot_results.json", [])
    tmp.unlink(missing_ok=True)
    return res[0] if res else {"id": spec["id"], "state": "ERROR"}


def review(proj: Path) -> None:
    subprocess.run([sys.executable, str(FORGE_REVIEW), str(proj)],
                   capture_output=True, text=True, timeout=180)




def calibrate(proj: Path) -> None:
    """Never trust the gates without checking them against known human verdicts first."""
    cal = proj / "beats_calibration.json"
    if not cal.is_file() or not MLX_PY.is_file():
        log("no calibration set — gate verdicts are UNVERIFIED this run")
        return
    r = subprocess.run([str(MLX_PY), str(SF / "pipeline-tools" / "beat_gate.py"), str(cal),
                        "--votes", "3", "--report", str(proj / "BEAT_GATE_calibration.md")],
                       capture_output=True, text=True, timeout=3600)
    for line in (r.stdout or "").splitlines():
        if "CALIBRATION" in line or "MISCAL" in line or "WARNING" in line:
            log("  " + line.split("] ", 1)[-1])


def wip_reel(proj: Path) -> None:
    """There is ALWAYS something to watch. Every cycle, stitch whatever passes.

    Matt woke to four hours of work and no artifact. A reel of the passing shots,
    in story order, costs seconds of ffmpeg and means the morning always has a file.
    """
    spine = read_json(proj / "beats.json", {}).get("spine", [])
    clips = []
    for need in spine:
        name = has_footage(proj, need.get("shots", []))
        if name:
            clips.append(proj / "clips" / name)
    if not clips:
        return
    lst = proj / "_wip_reel.txt"
    lst.write_text("".join(f"file '{c}'\n" for c in clips))
    out = proj / "WIP_REEL.mp4"
    subprocess.run(["ffmpeg", "-v", "error", "-f", "concat", "-safe", "0", "-i", str(lst),
                    "-c:v", "libx264", "-crf", "20", "-pix_fmt", "yuv420p", "-r", "24",
                    "-vf", "scale=832:480", str(out), "-y"], capture_output=True, timeout=900)
    lst.unlink(missing_ok=True)
    log(f"WIP reel updated: {len(clips)} passing shots → {out.name}")


def write_questions(proj: Path, state: dict) -> None:
    """The short list only a human can answer. Never buried in a log."""
    blocked = state.get("blocked", {})
    lines = ["# Decisions only you can make", ""]
    if not blocked:
        lines.append("_Nothing is blocked. The director is working._")
    else:
        lines.append(f"**{len(blocked)} shot(s) are stuck after escalating attempts.**")
        lines.append("")
        for shot, why in blocked.items():
            lines += [f"## {shot}", f"- what happened: {why}",
                      "- options: rewrite the beat as something visible · change the shot "
                      "(different angle/framing) · cut the beat from the spine · hand-build it",
                      ""]
    (proj / "QUESTIONS.md").write_text("\n".join(lines) + "\n")


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("project")
    ap.add_argument("--max-hours", type=float, default=8.0)
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    proj = Path(args.project).resolve()
    catalog = {s["id"]: s for s in read_json(proj / "shots.json", {}).get("shots", [])}
    state = read_json(proj / "director_state.json",
                      {"attempts": {}, "blocked": {}, "history": []})
    state["catalog"] = catalog
    deadline = time.time() + args.max_hours * 3600
    if not args.dry_run:
        log("calibrating the gates against known human verdicts before trusting them")
        calibrate(proj)

    while True:
        todo = gaps(proj, state)
        review(proj)
        write_questions(proj, state)
        if not args.dry_run:
            wip_reel(proj)
        if not todo:
            log("every required beat has footage — assembling the cut")
            if not args.dry_run:
                r = subprocess.run([sys.executable, str(BUILD_EPISODE), str(proj)],
                                   capture_output=True, text=True, timeout=7200)
                log((r.stdout or "").strip().splitlines()[-1] if r.stdout else "build finished")
            review(proj)
            log("FILM COMPLETE — stopping because there is nothing left to build")
            break

        if time.time() > deadline:
            log(f"stopping: hit the {args.max_hours}h limit with {len(todo)} beats open")
            break

        beat, shot_id = todo[0]
        log(f"{len(todo)} beats still open — working: {beat[:70]}")
        spec = catalog.get(shot_id)
        if not spec:
            state["blocked"][shot_id] = "no shot spec in shots.json — needs a human to write one"
            log(f"  BLOCKED {shot_id}: no spec, moving on")
            write_json(proj / "director_state.json", state)
            continue

        attempt = state["attempts"].get(shot_id, 0)
        if args.dry_run:
            log(f"  would run {shot_id}, attempt {attempt}")
            state["blocked"][shot_id] = "dry run"
            continue

        res = run_shot(proj, escalate(spec, attempt))
        state["attempts"][shot_id] = attempt + 1
        state["history"].append({"shot": shot_id, "attempt": attempt,
                                 "state": res.get("state"), "at": time.strftime("%H:%M")})
        log(f"  {shot_id} attempt {attempt} → {res.get('state')}")

        if res.get("state") in ("CLIP_KEPT", "CLIP_TRIMMED"):
            state["attempts"][shot_id] = 0
        elif attempt + 1 >= MAX_ATTEMPTS:
            why = ("still never passed the gates" if res.get("state") == "UNBUILT"
                   else "still locks but no animation holds the beat")
            state["blocked"][shot_id] = f"{why} after {MAX_ATTEMPTS} escalating attempts"
            log(f"  BLOCKED {shot_id} — {state['blocked'][shot_id]}; moving to the next beat")
        write_json(proj / "director_state.json", state)

    review(proj)
    blocked = state.get("blocked", {})
    if blocked:
        log("needs a human decision:")
        for k, v in blocked.items():
            log(f"  {k}: {v}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
