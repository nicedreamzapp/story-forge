#!/usr/bin/env python3
"""make-ltx-video — fast-mode i2v render via LTX-Video (Lightricks).

Drop-in alternative to make-video for scenes where Wan's 11 min/clip is overkill.
LTX-Video at 2B params renders 5-sec i2v at 768x512 in ~30-60 sec on M5 Max.

Usage:
  make-ltx-video --i2v INPUT.png --duration 5.0 --res 768x512 --label scene_01 "motion prompt"

Output: writes ~/AI/videopipe/outputs/<label>_ltx_<timestamp>.mp4
"""
import argparse
import sys
import time
from pathlib import Path

import torch
from PIL import Image
from diffusers import (
    AutoencoderKLLTXVideo,
    FlowMatchEulerDiscreteScheduler,
    LTXImageToVideoPipeline,
)
from diffusers.utils import export_to_video
from transformers import T5EncoderModel, T5Tokenizer

LTX_REPO = "Lightricks/LTX-Video"
LTX_DISTILLED_REPO = "Lightricks/LTX-Video-0.9.8-13B-distilled"


def get_args():
    p = argparse.ArgumentParser()
    p.add_argument("prompt", help="motion prompt")
    p.add_argument("--i2v", required=True, help="input still PNG/JPEG")
    p.add_argument("--duration", type=float, default=5.0)
    p.add_argument("--res", default="768x512")
    p.add_argument("--label", default="ltx")
    p.add_argument("--steps", type=int, default=8, help="LTX-distilled needs only ~8 steps")
    p.add_argument("--guidance", type=float, default=1.0,
                   help="LTX distilled is single-pass, MUST be 1.0 (no CFG)")
    p.add_argument("--decode-timestep", type=float, default=0.05,
                   help="Lightricks-recommended for distilled checkpoint")
    p.add_argument("--decode-noise-scale", type=float, default=0.025,
                   help="Lightricks-recommended for distilled checkpoint")
    p.add_argument("--negative-prompt", default=(
        "worst quality, inconsistent motion, blurry, jittery, distorted, "
        "low quality, ugly, deformed"))
    p.add_argument("--seed", type=int, default=None)
    p.add_argument("--out-dir", default=str(Path.home() / "AI/videopipe/outputs"))
    return p.parse_args()


def main():
    args = get_args()
    w, h = (int(x) for x in args.res.split("x"))
    fps = 24
    num_frames = int(args.duration * fps)

    # Round to LTX's required multiples (32 for width/height, 8 for frames)
    w = max(256, (w // 32) * 32)
    h = max(256, (h // 32) * 32)
    num_frames = max(9, ((num_frames - 1) // 8) * 8 + 1)

    out_dir = Path(args.out_dir)
    out_dir.mkdir(parents=True, exist_ok=True)
    ts = int(time.time())
    out_path = out_dir / f"{args.label}_ltx_{ts:08d}.mp4"

    print(f"[ltx] loading distilled LTX-Video pipeline...")
    t0 = time.time()
    model_path = Path.home() / "AI/ComfyUI/models/diffusion_models/ltx/ltxv-13b-0.9.8-distilled.safetensors"

    # The distilled single-file checkpoint is transformer-only — text encoder,
    # tokenizer, and VAE must be loaded separately from the HF repo. First run
    # will download ~5GB of T5 + ~400MB of VAE into the HF cache; subsequent
    # runs reuse the cache.
    print(f"[ltx] loading T5 text encoder + tokenizer + VAE from {LTX_REPO}...")
    text_encoder = T5EncoderModel.from_pretrained(
        LTX_REPO, subfolder="text_encoder", torch_dtype=torch.bfloat16,
    )
    tokenizer = T5Tokenizer.from_pretrained(LTX_REPO, subfolder="tokenizer")
    vae = AutoencoderKLLTXVideo.from_pretrained(
        LTX_REPO, subfolder="vae", torch_dtype=torch.bfloat16,
    )
    print(f"[ltx] loading transformer from {model_path.name}...")
    pipe = LTXImageToVideoPipeline.from_single_file(
        str(model_path),
        text_encoder=text_encoder,
        tokenizer=tokenizer,
        vae=vae,
        torch_dtype=torch.bfloat16,
    ).to("mps")

    # diffusers 0.38 single-file loader mis-classifies 0.9.8-distilled as
    # 0.9.7-dev and loads a linear scheduler (shift=1.0). The distilled model
    # was trained on the shifted dynamic schedule from its HF repo — without
    # this override, sampling produces psychedelic noise.
    print(f"[ltx] overriding scheduler with distilled-specific config...")
    try:
        pipe.scheduler = FlowMatchEulerDiscreteScheduler.from_pretrained(
            LTX_DISTILLED_REPO, subfolder="scheduler",
        )
        print(f"[ltx] scheduler loaded from {LTX_DISTILLED_REPO}")
    except Exception as e:
        print(f"[ltx] could not fetch distilled scheduler ({e}); "
              f"falling back to manual shift config")
        pipe.scheduler = FlowMatchEulerDiscreteScheduler(
            shift=2.05, use_dynamic_shifting=True,
            base_shift=0.5, max_shift=2.05,
        )

    print(f"[ltx] model loaded in {time.time()-t0:.1f}s")

    print(f"[ltx] loading input still: {args.i2v}")
    image = Image.open(args.i2v).convert("RGB").resize((w, h), Image.LANCZOS)

    generator = torch.Generator(device="mps")
    if args.seed is not None:
        generator.manual_seed(args.seed)

    print(f"[ltx] rendering {num_frames} frames @ {w}x{h}, {args.steps} steps...")
    t1 = time.time()
    result = pipe(
        prompt=args.prompt,
        negative_prompt=args.negative_prompt,
        image=image,
        height=h,
        width=w,
        num_frames=num_frames,
        num_inference_steps=args.steps,
        guidance_scale=args.guidance,
        decode_timestep=args.decode_timestep,
        decode_noise_scale=args.decode_noise_scale,
        generator=generator,
    )
    print(f"[ltx] inference: {time.time()-t1:.1f}s")

    export_to_video(result.frames[0], str(out_path), fps=fps)
    print(f"[ltx] done -> {out_path}")
    print(f"[ltx] total: {time.time()-t0:.1f}s (vs Wan's ~660s)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
