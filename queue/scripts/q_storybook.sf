# q_storybook.sf — LOCKED HERO for character consistency.
# The fix: one detailed $hero "bible" reused VERBATIM in every scene, plus a
# FIXED seed on every still. Proven to keep the same child across shots (instead
# of it turning into a fox). The fox is declared as a clearly SEPARATE side char.

$style = "hand-painted children's book illustration, soft gouache and watercolor, Studio Ghibli warmth, golden-hour light, painterly soft edges, gentle and cozy, 4k"

# THE HERO — locked. Species/age/hair/hat/clothes/prop all pinned so it can't drift.
$hero = "a small human child age 5, round face, short brown hair under a rust-orange knitted bobble hat, cream knitted sweater, forest-green pants, brown boots, holding a glowing paper lantern"

film "Last Light" slug=q_storybook target=m5

voice warm: piper/en_US-libritts_r-medium speaker=0 length=1.16
music score: ace/warm-cinematic-underscore vol=0.30

@transition xfade dur=0.5
@mix duck voice -> music threshold=-22 ratio=4

scene dusk_path:
    still flux:
        prompt: "{$style}, wide shot, {$hero}, walking a mossy forest path at dusk, tall pines, drifting fireflies, warm lantern glow, deep painterly shadows"
        seed: 778899
    motion ltx:
        prompt: "slow gentle push-in, fireflies drift, lantern light flickers softly, leaves stir"
        duration: 5.0
    narrate warm:
        line: "When the last light left the trees, she lit the little lantern and started home."
    music score vol=0.30

scene the_door:
    still flux:
        prompt: "{$style}, {$hero}, standing at a warm wooden cabin doorway in the snow at night, a small red fox sitting on the doorstep beside her, warm golden light spilling from the open door"
        seed: 778899
    motion ltx:
        prompt: "warm light glows from the doorway, the fox's ears twitch, soft snow drifts down"
        duration: 5.0
    narrate warm:
        line: "Someone had left the door open, and the warmth spilling out already knew her name."
    music score vol=0.30
