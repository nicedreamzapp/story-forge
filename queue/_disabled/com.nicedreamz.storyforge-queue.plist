<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nicedreamz.storyforge-queue</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/dtribe/story-forge-queue/runner.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- PUBLIC=0 -> upload UNLISTED + text Matt to approve. Set to 1 for hands-off public+tweet. -->
        <key>PUBLIC</key>
        <string>0</string>
        <key>SF_ENGINE</key>
        <string>lean</string>
        <!-- launchd's PATH is minimal; render needs homebrew (ffmpeg etc). -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/Users/dtribe/story-forge-queue/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dtribe/story-forge-queue/logs/launchd.log</string>
</dict>
</plist>
