# wolves howling at neon moon  — generated by idea_factory.py (narration-free viral short)
# caption (burned in post): the moon is their disco ball

$style = "ultra-detailed cinematic 8k, neon glow, dramatic volumetric lighting, hyper-realistic fur textures"

film "wolves howling at neon moon" slug=vf_wolves_howling_at_neon_moon_28036 target=m5 format=reel

music bed: ace/synthwave-moonlight-ambient vol=0.32

@transition xfade dur=0.4

scene beat_0:
    still flux:
        prompt: "{$style}, a lone wolf standing on a rocky cliff, howling at a massive neon pink and purple moon hanging low in a dark stormy sky, bioluminescent plants glowing in the foreground with sparks of light floating upward"
        seed: auto
    motion ltx:
        prompt: "slow camera dolly in from distance, wind howling through the wolf's fur as it lifts its head to howl"
        duration: 4.0
    music bed vol=0.32
