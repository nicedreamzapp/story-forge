# wolves howling at neon moon  — generated by idea_factory.py (narration-free viral short)
# caption (burned in post): the moon is their conductor

$style = "hyper-detailed cinematic 3D animation, neon bioluminescent glow, dramatic rim light, 8k resolution"

film "wolves howling at neon moon" slug=vf_wolves_howling_at_neon_moon_28038 target=m5 format=reel

music bed: ace/ethereal-dark-ambient-pulse vol=0.32

@transition xfade dur=0.4

scene beat_0:
    still flux:
        prompt: "{$style}, a pack of sleek gray wolves standing on a misty forest clearing, their mouths open in unison howling directly at a vibrant pink and purple neon moon hanging low in the midnight sky, dew drops glisten on their fur"
        seed: auto
    motion ltx:
        prompt: "camera slowly orbits the wolves while they maintain their howling pose, the moon's neon light flickers with their collective sound waves"
        duration: 4.0
    music bed vol=0.32
